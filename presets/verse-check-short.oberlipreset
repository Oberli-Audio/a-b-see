<?xml version="1.0" encoding="UTF-8"?>

<OberliPreset name="Verse Check Short-Term" author="Oberli Audio" category="Mixing"
              description="Short-term match on section 1, for a quiet verse where integrated numbers mislead."
              pluginVersion="0.1.0" created="2026-11-01" factory="true">
  <ABSeeState version="1" dspVersion="1">
    <PARAMETERS>
      <PARAM id="listen" value="1"/>
      <PARAM id="refSlot" value="0"/>
      <PARAM id="matchMode" value="1"/>
      <PARAM id="blind" value="0"/>
      <PARAM id="trim" value="0"/>
      <PARAM id="mono" value="0"/>
      <PARAM id="followTransport" value="1"/>
      <PARAM id="trimMixInstead" value="0"/>
      <PARAM id="section" value="1"/>
      <PARAM id="matchTarget" value="-14"/>
      <PARAM id="bypass" value="0"/>
    </PARAMETERS>
    <Extra/>
  </ABSeeState>
</OberliPreset>
